# ==============================================================================
# MEDNOURISH Local Development Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to Git!
# ==============================================================================

# Application Environment
ENVIRONMENT=local_emulator
PROJECT_NAME=MEDNOURISH
VERSION=0.1.0-alpha

# Firebase Emulator Configuration
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-mednourish

# MySQL Configuration (Primary Structured Application Data)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=mednourish_dev

# MongoDB Configuration (Versioned Reference Content)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=mednourish_reference
